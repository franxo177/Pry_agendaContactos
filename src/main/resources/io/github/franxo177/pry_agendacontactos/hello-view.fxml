<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:controller="io.github.franxo177.pry_agendacontactos.controller.PrincipalController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

   <children>
      <Label layoutX="26.0" layoutY="17.0" text="Agenda Contactos">
         <font>
            <Font name="JetBrains Mono ExtraBold Italic" size="37.0" />
         </font>
         <effect>
            <Reflection fraction="0.54" topOpacity="0.45" />
         </effect>
      </Label>
      <Label layoutX="35.0" layoutY="150.0" text="ID">
         <font>
            <Font name="JetBrains Mono ExtraBold Italic" size="12.0" />
         </font>
      </Label>
      <Label layoutX="35.0" layoutY="200.0" text="Nombre">
         <font>
            <Font name="JetBrains Mono ExtraBold Italic" size="12.0" />
         </font>
      </Label>
      <Label layoutX="35.0" layoutY="250.0" text="Apellido">
         <font>
            <Font name="JetBrains Mono ExtraBold Italic" size="12.0" />
         </font>
      </Label>
      <Label layoutX="35.0" layoutY="300.0" text="Telefono">
         <font>
            <Font name="JetBrains Mono ExtraBold Italic" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtId" layoutX="130.0" layoutY="145.0" />
      <TextField fx:id="txtNombre" layoutX="130.0" layoutY="195.0" />
      <TextField fx:id="txtApellido" layoutX="130.0" layoutY="245.0" />
      <TextField fx:id="txtTelefono" layoutX="130.0" layoutY="295.0" />
      <Button fx:id="btnAgregar" layoutX="175.0" layoutY="360.0" mnemonicParsing="false" onAction="#agregar" text="Agregar" />
      <TableView fx:id="tablaContactos" layoutX="450.0" layoutY="130.0" prefHeight="250.0" prefWidth="400.0">
