          <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="100.0" text="NOMBRE" />
            <TableColumn fx:id="colApellido" prefWidth="100.0" text="APELLIDO" />
            <TableColumn fx:id="colTelefono" prefWidth="130.0" text="TELEFONO" />
        </columns>
      </TableView>
      <Button fx:id="btnEliminar" layoutX="620.0" layoutY="400.0" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
   </children>
</AnchorPane>
